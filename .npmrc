# Railway builds with NODE_ENV=production, which makes `npm ci` omit
# devDependencies — and `next build` needs typescript, tailwindcss, postcss,
# and the prebuild theme check needs tsx. The 2026-09-11 18:26 deploy failed
# exactly this way (123 packages installed instead of 596, "tsx: not found").
# `include=dev` wins over the NODE_ENV default, so the build no longer
# depends on a Railway variable being present. Locally this changes nothing.
include=dev
